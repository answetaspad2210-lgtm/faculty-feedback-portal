# ===== SERVER ENVIRONMENT VARIABLES =====
# Copy this file to server/.env and fill in real values.
# NEVER commit the real .env file.

# Port the Express server will run on
PORT=5000

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/faculty-feedback-portal

# Secret used to sign JWT tokens - use a long random string in production
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma separated list of allowed origins for CORS
CLIENT_ORIGIN=http://localhost:5173

# bcrypt salt rounds (10-12 is a good default)
BCRYPT_SALT_ROUNDS=10
